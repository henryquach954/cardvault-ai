{
  "name": "pokemon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:providers": "tsx scripts/verify-providers.ts",
    "verify:valuation": "tsx scripts/verify-valuation.ts",
    "verify": "npm run verify:schema && npm run verify:local && npm run verify:render && npm run verify:providers && npm run verify:valuation",
    "verify:local": "tsx scripts/verify-local-store.ts",
    "verify:render": "tsx --tsconfig tsconfig.app.json scripts/verify-render.tsx"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
