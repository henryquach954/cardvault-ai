# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Never put the service_role key in a VITE_ variable. Anything prefixed VITE_
# is compiled into the JavaScript bundle your browser downloads.
